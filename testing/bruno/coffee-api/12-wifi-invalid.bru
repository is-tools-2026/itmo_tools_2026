meta {
  name: Длина пароля не число
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/wifi-password?length=abc
  body: none
  auth: none
}

tests {
  test("Статус 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Содержимое JSON", function() {
    expect(res.getHeader("content-type")).to.include("application/json");
    const body = res.getBody();
    expect(body.error).to.be.a("string").and.not.empty;
  });
}

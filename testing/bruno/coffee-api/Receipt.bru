meta {
  name: Receipt
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/receipt
  body: json
  auth: inherit
}

body:json {
  {
    "drink_name": "latte",
    "quantity": 2
  }
}

tests {
  test("Status code is 200", function () {
      expect(res.status).to.equal(200);
  });
  
  test("Response contains receipt", function () {
      expect(res.body).to.have.property("receipt");
  });
  
  test("Receipt is a string", function () {
      expect(res.body.receipt).to.be.a("string");
  });
  
  test("Receipt contains drink name", function () {
      expect(res.body.receipt).to.include("latte");
  });
  
  test("Receipt contains quantity", function () {
      expect(res.body.receipt).to.include("Количество: 2");
  });
  
  test("Receipt contains correct total", function () {
      expect(res.body.receipt).to.include("Итого: 560 руб.");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}

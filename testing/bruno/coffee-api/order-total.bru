meta {
  name: Order Total
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/order-total
  body: json
  auth: none
}

body:json {
  {
    "quantity": 3,
    "price": 280
  }
}

assert {
  res.status: 200
  res.body.total: 840
}

tests {
    test("статус 200", function() {
        expect(res.getStatus()).to.equal(200);
    });
    
    test("есть поле total", function() {
        expect(res.getBody()).to.have.property("total");
    });

    test("total = 840", function() {
        expect(res.getBody().total).to.equal(840);
    });

    test("total — число", function() {
        expect(res.getBody().total).to.be.a("number");
    });

    test("ответ быстрее 500 мс", function() {
        expect(res.getResponseTime()).to.be.lessThan(500);
    });
  
}

meta {
  name: Сумма заказа
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/order-total
  body: json
  auth: none
}

body:json {
  {
    "quantity": 3,
    "price": 280
  }
}

tests {
  test("Статус 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Содержимое JSON", function() {
    expect(res.getHeader("content-type")).to.include("application/json");
    const body = res.getBody();
    expect(body).to.include({quantity: 3, price: 280, total: 840});
  });
}

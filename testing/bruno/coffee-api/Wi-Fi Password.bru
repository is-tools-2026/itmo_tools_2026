meta {
  name: Wi-Fi Password
  type: http
  seq: 3
}

get {
  url: http://127.0.0.1:5001/api/wifi-password?length=8
  body: none
  auth: inherit
}

params:query {
  length: 8
}

tests {
  
  test("Status code is 200", function () {
      expect(res.status).to.equal(200);
  });
  
  test("Response contains password", function () {
      expect(res.body).to.have.property("password");
  });
  
  test("Password length is 8", function () {
      expect(res.body.password.length).to.equal(8);
  });
  
  test("Response length is 8", function () {
      expect(res.body.length).to.equal(8);
  });
  
  test("Password is a string", function () {
      expect(res.body.password).to.be.a("string");
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
